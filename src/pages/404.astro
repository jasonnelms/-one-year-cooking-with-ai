---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
  <section class="not-found">
    <span aria-hidden="true">404</span>
    <h1>This recipe wandered out of the kitchen.</h1>
    <p>The page may have moved, or the AI may have hallucinated a casserole.</p>
    <a class="button button-primary" href="/recipes/">Return to the recipes</a>
  </section>
</Layout>
