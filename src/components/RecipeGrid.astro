---
import type { Recipe } from '../types';
import RecipeCard from './RecipeCard.astro';

interface Props {
  recipes: Recipe[];
  showFilters?: boolean;
}

const { recipes, showFilters = true } = Astro.props;
---

<section class="recipe-browser" data-recipe-browser>
  {showFilters && recipes.length > 0 && (
    <div class="filters" aria-label="Filter recipes">
      <label class="search-box">
        <span>Search the year</span>
        <input type="search" placeholder="chicken, smoker, disaster…" data-recipe-search />
      </label>
      <div class="filter-buttons" role="group" aria-label="Filter by verdict">
        <button class="filter-active" type="button" data-status-filter="all">All</button>
        <button type="button" data-status-filter="awaiting-verdict">Awaiting verdict</button>
        <button type="button" data-status-filter="hit">Hits</button>
        <button type="button" data-status-filter="needs-work">Needs work</button>
        <button type="button" data-status-filter="miss">Misses</button>
        <button type="button" data-status-filter="magnificent-disaster">Disasters</button>
      </div>
    </div>
  )}

  <div class="recipe-grid" data-recipe-grid>
    {recipes.map((recipe) => <RecipeCard recipe={recipe} />)}
  </div>

  {recipes.length === 0 && (
    <div class="empty-state">
      <span aria-hidden="true">🍳</span>
      <h2>The pan is heating up.</h2>
      <p>The first recipe will appear here as soon as Jason tells ChatGPT, “Publish it.”</p>
    </div>
  )}

  <p class="no-results" data-no-results hidden>No recipes match that particular craving.</p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-recipe-browser]').forEach((browser) => {
    const cards = [...browser.querySelectorAll<HTMLElement>('[data-recipe-card]')];
    const search = browser.querySelector<HTMLInputElement>('[data-recipe-search]');
    const buttons = [...browser.querySelectorAll<HTMLButtonElement>('[data-status-filter]')];
    const noResults = browser.querySelector<HTMLElement>('[data-no-results]');
    let activeStatus = 'all';

    const applyFilters = () => {
      const query = search?.value.trim().toLowerCase() || '';
      let visible = 0;
      cards.forEach((card) => {
        const statusMatches = activeStatus === 'all' || card.dataset.status === activeStatus;
        const searchMatches = !query || card.dataset.search?.includes(query);
        const show = Boolean(statusMatches && searchMatches);
        card.hidden = !show;
        if (show) visible += 1;
      });
      if (noResults) noResults.hidden = visible > 0;
    };

    search?.addEventListener('input', applyFilters);
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        activeStatus = button.dataset.statusFilter || 'all';
        buttons.forEach((item) => item.classList.toggle('filter-active', item === button));
        applyFilters();
      });
    });
  });
</script>
